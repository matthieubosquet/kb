PREFIX : <http://jena.apache.org/fuseki#>

# The Fuseki service. The build appends text.ttl (full-text search) and
# dataset.ttl (the data and inference) to this file.
[
    a :Service ;

    # Path prefix for the fuseki service
    :name "" ;

    # Read-only SPARQL endpoint (at root as no name)
    :endpoint [
        :operation :query ;
    ] ;

    # The data exposed by this service: the dataset with full-text search,
    # defined in text.ttl. With FULL_TEXT=false the build points this at
    # <urn:kb:dataset> (dataset.ttl) instead.
    :dataset <urn:kb:text-dataset> ;
] .
